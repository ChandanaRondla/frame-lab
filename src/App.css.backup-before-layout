@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');

:root{font-family:'DM Sans',sans-serif;color:#e9edf5;background:#0b1018;font-synthesis:none}
*{box-sizing:border-box}
body{margin:0;min-width:320px}
button{font:inherit;cursor:pointer}
.shell{min-height:100vh;display:flex}
.sidebar{width:255px;flex-shrink:0;background:#0d131d;border-right:1px solid #202838;padding:30px 18px;display:flex;flex-direction:column}
.brand{display:flex;align-items:center;gap:12px;font-family:'Space Grotesk',sans-serif;font-size:21px;font-weight:700;letter-spacing:-.6px;padding:4px 10px 52px}
.brand span:not(.brand-mark){color:#78d7dc}
.brand small{display:block;font-family:'DM Sans',sans-serif;font-size:9px;letter-spacing:2.4px;color:#778396;margin-top:5px}
.brand-mark{display:grid;place-items:center;width:37px;height:37px;background:#7ad8dc;color:#0a111a;border-radius:9px;font-size:24px}
.side-label,.section-label,.eyebrow{color:#7b889b;font-size:10px;font-weight:700;letter-spacing:2px}
.side-label{padding:0 13px 15px}
nav{display:grid;gap:6px}
.nav{display:flex;align-items:center;gap:13px;width:100%;border:0;background:transparent;color:#9ba7b9;text-align:left;padding:14px;border-radius:9px;font-size:13px}
.nav.active{background:#18313d;color:#85e4e7}
.nav:hover{background:#192332;color:#fff}
.sidebar-bottom{margin-top:auto;border-top:1px solid #263040;padding:24px 10px 4px;font-size:10px;letter-spacing:1px;color:#b9c5d2;line-height:2}
.sidebar-bottom small{color:#778397;letter-spacing:0}
.status-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#76d4b3;margin-right:8px}
.main{flex:1;min-width:0}
.topbar{padding:36px 46px 30px;border-bottom:1px solid #202838;display:flex;justify-content:space-between;align-items:center;gap:20px}
.breadcrumb{font-size:10px;color:#80d4dc;letter-spacing:2px;font-weight:700}
h1,h2,p{margin-top:0}
h1{font:600 33px 'Space Grotesk',sans-serif;letter-spacing:-1.4px;margin:12px 0 7px}
.topbar p,.panel-heading p,.sim-toolbar p{color:#8996a9;font-size:13px;margin:0}
.primary{background:#8cdee0;color:#0b151c;border:0;border-radius:8px;padding:13px 18px;font-weight:700;font-size:12px;display:flex;align-items:center;gap:9px}
.primary:disabled{opacity:.6;cursor:wait}
.content{padding:35px 46px;max-width:1600px;margin:auto}
.section-label{display:flex;justify-content:space-between;margin-bottom:18px}
.section-label span{color:#566476;letter-spacing:0;font-weight:400}
.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:23px}
.metric,.panel{background:#111925;border:1px solid #273243;border-radius:12px}
.metric{padding:21px}
.metric-top{display:flex;justify-content:space-between;align-items:center;color:#8b9bad;font-size:10px;font-weight:700;letter-spacing:1px;gap:8px}
.metric-top svg{color:#75cfd5}
.metric>strong{display:block;font:600 32px 'Space Grotesk',sans-serif;margin:24px 0 7px}
.metric>small{font-size:11px;color:#8290a2}
.two-col{display:grid;grid-template-columns:1.45fr 1fr;gap:20px}
.panel{padding:24px}
.panel-heading{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:28px}
.panel-heading h2,.sim-toolbar h2,.experiment-page h2{font:600 19px 'Space Grotesk',sans-serif;margin:0 0 6px}
.panel-heading svg{color:#7dd7db}
.tag{border:1px solid #315560;border-radius:4px;color:#8ee3e7;padding:6px 8px;font-size:9px;letter-spacing:1px}
.empty-chart{height:260px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#a4b4c7;font-size:14px;line-height:2;text-align:center}
.empty-chart span{font-size:12px;color:#64758a}
.variant-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.variant{position:relative;text-align:left;background:#151f2e;border:1px solid #303c4f;border-radius:9px;color:#fff;padding:20px 14px;min-height:145px}
.variant.selected,.variant:hover{border-color:#7dd5dc;background:#1b303b}
.variant>span{font-size:9px;letter-spacing:1.5px;color:#86dce1}
.variant strong{display:block;font-size:15px;margin:18px 0 6px}
.variant small{color:#8797a9;font-size:11px}
.variant svg{position:absolute;right:12px;top:15px;color:#8bdde1}
.info-note{border-top:1px solid #273344;margin-top:24px;padding-top:18px;color:#8192a5;font-size:12px;line-height:1.7}
.sim-toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}
.switcher{display:flex;gap:5px;background:#141d2a;border:1px solid #303b4c;padding:5px;border-radius:9px}
.switcher button{background:transparent;border:0;color:#9aa9ba;border-radius:6px;padding:10px 15px;font-size:12px}
.switcher button.chosen{background:#7fd5dc;color:#0c1620;font-weight:700}
.tv-screen{background:#090d15;border:1px solid #344355;border-radius:14px;padding:30px;min-height:600px;box-shadow:0 18px 60px #0005}
.tv-header{display:flex;justify-content:space-between;align-items:center;color:#adb9c9;font-size:10px;letter-spacing:1.6px}
.tv-header strong{font-size:20px;color:white;letter-spacing:-.7px}
.tv-header strong span{color:#8ae0e4}
.tv-header small{color:#87dce0}
.tv-hero{background:linear-gradient(115deg,#182e42,#243b4c 48%,#0c1825);border-radius:9px;padding:55px 35px;margin:27px 0 28px;min-height:220px}
.tv-hero>span{color:#93d9e1;letter-spacing:2px;font-size:10px;font-weight:700}
.tv-hero h2{font:600 32px 'Space Grotesk',sans-serif;margin:17px 0 10px}
.tv-hero p{color:#bdcbd8;font-size:13px}
.tv-row-label{font-size:12px;font-weight:700;letter-spacing:1px;margin-bottom:16px}
.tv-row-label small{font-weight:400;color:#78899b;margin-left:12px}
.tv-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}
.tv-screen.editorial .tv-grid{grid-template-columns:repeat(3,1fr);gap:22px}
.poster{border:2px solid transparent;border-radius:9px;background:#172234;padding:6px 6px 12px;min-width:0}
.poster.focused{border-color:#a6f0f1;box-shadow:0 0 0 3px #8de0e333;transform:scale(1.02)}
.poster-art{height:100px;display:flex;align-items:flex-end;padding:14px;font:600 29px 'Space Grotesk',sans-serif;color:#ffffff75;border-radius:5px;margin-bottom:11px}
.poster-0{--poster:#244b5d}.poster-1{--poster:#59354f}.poster-2{--poster:#554a2f}.poster-3{--poster:#314b55}.poster-4{--poster:#513a3d}.poster-5{--poster:#343c65}
.poster-art{background:linear-gradient(145deg,var(--poster),#0d1724)}
.poster strong{display:block;font-size:12px;padding:0 6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.poster small{display:block;font-size:9px;color:#8a98aa;margin-top:6px;padding:0 6px}
.editorial .poster-art{height:145px}
.sim-footer{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:20px 0;font-size:11px;color:#8696a8}
.sim-footer strong{color:#fff}
.sim-footer button{display:flex;align-items:center;gap:7px;border:1px solid #344154;border-radius:7px;background:#172130;color:#b7c6d6;padding:10px}
.experiment-page{max-width:900px;padding:38px}
.experiment-page h2{font-size:26px;margin:15px 0}
.experiment-page>p{color:#a5b3c4;font-size:14px;line-height:1.8;max-width:680px;margin-bottom:28px}
.quality-row{padding:23px 0;border-bottom:1px solid #2b3748;display:flex;justify-content:space-between;gap:15px;font-size:14px}
.quality-row strong{font-size:11px;color:#90a2b8;letter-spacing:1px}
@media(max-width:1100px){.metrics{grid-template-columns:repeat(2,1fr)}.two-col{grid-template-columns:1fr}.sidebar{width:215px}.content{padding:25px}.topbar{padding:30px 25px}}
@media(max-width:700px){.shell{display:block}.sidebar{width:100%;padding:15px}.brand{padding-bottom:15px}.sidebar nav{display:flex;overflow-x:auto}.nav{white-space:nowrap}.sidebar-bottom{display:none}.topbar{padding:25px 18px;align-items:flex-start}.topbar h1{font-size:25px}.content{padding:18px}.metrics{grid-template-columns:1fr 1fr;gap:10px}.metric{padding:13px}.metric>strong{font-size:23px}.variant-grid{grid-template-columns:1fr}.tv-screen{padding:15px}.tv-hero{padding:30px 15px}.tv-hero h2{font-size:23px}.tv-grid{gap:6px}.poster-art{height:75px}.sim-footer{flex-wrap:wrap}}

.comparison-grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:18px;
  margin-top:24px;
}

.comparison-card{
  padding:24px;
  background:#151f2e;
  border:1px solid #303d4f;
  border-radius:12px;
}

.comparison-card h3{
  font:600 21px 'Space Grotesk',sans-serif;
  margin:14px 0 25px;
}

.comparison-stat{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px;
  padding:15px 0;
  border-bottom:1px solid #2c394b;
  font-size:12px;
  color:#9baabe;
}

.comparison-stat strong{
  font-size:14px;
  color:#e9edf5;
  white-space:nowrap;
}

.comparison-card .primary{
  margin-top:24px;
}

.quality-description{
  display:block;
  color:#8192a5;
  font-size:11px;
  margin-top:7px;
}

@media(max-width:700px){
  .comparison-grid{grid-template-columns:1fr}
}


/* Cinematic artwork */
.tv-hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  background:
    linear-gradient(90deg, rgba(8, 16, 28, .95) 0%,
                           rgba(8, 16, 28, .72) 52%,
                           rgba(8, 16, 28, .22) 100%),
    url('/backdrops/featured.jpg') center 43% / cover no-repeat;
}

.tv-hero > * {
  position: relative;
  z-index: 1;
}

.poster-art {
  overflow: hidden;
  position: relative;
  padding: 0 !important;
  background: #101827;
}

.poster-art img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 22%;
  transition: transform 220ms ease;
}

.poster.focused .poster-art img {
  transform: scale(1.045);
}

.poster {
  overflow: hidden;
}

.tv-screen.editorial .poster-art img {
  object-position: center 30%;
}


/* Interactive movie cards */
button.poster {
  display: block;
  width: 100%;
  text-align: left;
  font: inherit;
  color: inherit;
  cursor: pointer;
  border: 1px solid transparent;
  appearance: none;
}

button.poster:hover {
  border-color: #74d5db;
  transform: translateY(-2px);
}

button.poster:focus-visible {
  outline: 2px solid #74d5db;
  outline-offset: 3px;
}

.movie-details {
  display: flex;
  align-items: center;
  gap: 24px;
  margin-top: 22px;
  padding: 24px;
  background: #141e2d;
  border: 1px solid #304155;
  border-radius: 12px;
}

.movie-details img {
  width: 110px;
  height: 150px;
  object-fit: cover;
  border-radius: 8px;
}

.movie-details h2 {
  margin: 10px 0;
}

.movie-details p {
  color: #a5b4c8;
  line-height: 1.6;
}

.movie-details .primary {
  margin-top: 12px;
}
